rules_version = '2';
// LinkBio Lite Firestore rules — v1.
// profiles/{slug}: slug IS the document ID (first-come-first-served
// claim, uniqueness comes free from Firestore doc IDs). Publicly
// readable (that's the whole point — a public bio page); writable only
// by the account that created it.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function withinLength(field, maxLen) { return field is string && field.size() <= maxLen; }

    match /profiles/{slug} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && withinLength(request.resource.data.displayName, 60)
        && withinLength(request.resource.data.bio, 200)
        && request.resource.data.links is list
        && request.resource.data.links.size() <= 20;
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && withinLength(request.resource.data.displayName, 60)
        && withinLength(request.resource.data.bio, 200)
        && request.resource.data.links is list
        && request.resource.data.links.size() <= 20;
      allow delete: if false;
    }
  }
}
